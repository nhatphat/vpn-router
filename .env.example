# Base32 TOTP setup secret, WITHOUT spaces.
# Example only; replace with your real secret.
TOTP_SECRET=YOUR_BASE32_SECRET

# The two below are read only by docker-compose.yml, which is for working on
# the image by hand. vpnctl takes the published port from docker.socks and the
# retry delay from vpn.retry_delay in its own config.
SOCKS_PORT=1080
RETRY_DELAY=5
